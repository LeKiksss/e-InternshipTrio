# Copy this file to .env only when local overrides are needed. The real .env is ignored.
# Local mode can leave this blank. Public mode requires a unique value of 32+ characters.
SECRET_KEY=

# Local server settings. Use 0.0.0.0 only when access from another device is intended.
APP_HOST=127.0.0.1
APP_PORT=5000

# Keep false for ordinary local HTTP. serve_public.py enables this securely for the tunnel.
PUBLIC_HTTPS_MODE=false

# Optional database override. Relative SQLite files are resolved by Flask inside instance/.
# DATABASE_URL=sqlite:///prototype.db

# Backend-only Gemini configuration. Leave blank to use the deterministic optimizer.
GEMINI_API_KEY=
GEMINI_INTERPRETER_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
# Optional location for one JSON file per outbound Gemini request.
GEMINI_REQUEST_LOG_DIR=instance/api_request_logs
