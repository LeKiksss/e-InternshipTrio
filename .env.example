# Copy this file to .env for local overrides. The real .env file is ignored.
# Generate your own long random value; never deploy the example value below.
SECRET_KEY=replace-with-a-long-random-development-secret

# Local server settings. Use 0.0.0.0 only when access from another device is intended.
APP_HOST=127.0.0.1
APP_PORT=5000

# Optional database override. Relative SQLite files are resolved by Flask inside instance/.
# DATABASE_URL=sqlite:///prototype.db

